# ==============================================================================
# FOODSAVE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. LIVE CLOUD DATABASE (Recommended: Supabase or Neon.tech - Free Forever)
# Get a free cloud PostgreSQL database in 60 seconds:
# - Supabase: https://supabase.com (Sign in -> New Project -> Project Settings -> Database -> Connection String URI)
# - Neon: https://neon.tech (Sign in -> Create Project -> Copy Connection String)
#
# Paste your Cloud Database Connection String below:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. LOCAL SQLITE DATABASE (Default for local development if DATABASE_URL is not set)
# DATABASE_URL=sqlite:///foodsave.db

# 3. JWT Security Key
SECRET_KEY=foodsave-super-secret-jwt-key-2026-secure-production-ready

# 4. Optional Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. Optional Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@foodsave.org
SMTP_PASSWORD=your_app_password
